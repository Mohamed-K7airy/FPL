{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build --prefix server",
    "nixpacksConfig": {
      "providers": ["node"],
      "variables": {
        "NIXPACKS_NODE_VERSION": "22"
      }
    }
  },
  "deploy": {
    "startCommand": "npm start --prefix server",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
